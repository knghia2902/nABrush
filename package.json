{
  "name": "nabrush",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first screen annotation overlay for macOS and Windows",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke:short": "wdio run wdio.conf.ts --suite short-lifecycle",
    "smoke:matrix": "wdio run wdio.conf.ts --suite phase1-matrix",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-global-shortcut": "2.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "@wdio/cli": "9.31.7",
    "@wdio/local-runner": "9.31.7",
    "@wdio/mocha-framework": "9.31.7",
    "@wdio/spec-reporter": "9.31.2",
    "@wdio/tauri-service": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
