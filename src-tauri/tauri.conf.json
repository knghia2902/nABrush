{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nABrush",
  "version": "0.1.0",
  "identifier": "com.nabrush.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "overlay",
        "title": "nABrush Overlay",
        "url": "index.html",
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "focusable": true,
        "skipTaskbar": true,
        "resizable": false,
        "fullscreen": false
      },
      {
        "label": "settings",
        "title": "nABrush Settings",
        "url": "index.html",
        "visible": false,
        "resizable": false,
        "center": true,
        "width": 480,
        "height": 360
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": { "active": false, "icon": [] }
}
